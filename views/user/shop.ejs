	<script>
		const urlParams = new URLSearchParams(window.location.search);
		const wishlistStatus = urlParams.get('wishlist');
	  
		if (wishlistStatus === 'added') {
		  Swal.fire({
			icon: 'success',
			title: 'Added to wishlist',
			showConfirmButton: false,
			timer: 1500
		  });
		} else if (wishlistStatus === 'exists') {
		  Swal.fire({
			icon: 'info',
			title: 'Already in the wishlist',
			showConfirmButton: false,
			timer: 1500
		  });
		}


		  // Optional: remove the query param from the URL after showing the alert
		  if (window.history.replaceState) {
			const cleanUrl = window.location.href.split('?')[0];
			window.history.replaceState(null, null, cleanUrl);
		  }
	  </script>
	  


	  <script>
		// Force full reload when user navigates back
		window.addEventListener('pageshow', function (event) {
		  if (event.persisted) {
			window.location.reload();
		  }
		});
	  </script>


