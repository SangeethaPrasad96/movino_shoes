		  type="text"
		  name="query"
		  placeholder="Search products..."
		  value="<%= query %>"
		  class="form-control"
		  style="max-width: 220px;"
		/>
  
		<!-- Sort dropdown -->
	
	  </div>
	</div>
  </div>
  
  <!-- Filters Section -->
  <div class="container">
<div class="row">
 <!-- Left Column: Filters -->
	  <div class="col-md-4 col-lg-3">
		<div class="d-flex justify-content-between align-items-center mb-2">
		  <h5 class="mb-0">Filters</h5>
		  <a href="/shop" class="text-decoration-none" style="color: #d6334e; font-size: 14px;font-family: Georgia, 'Times New Roman', Times, serif;">CLEAR ALL</a>
		</div>
  
		<!-- Category -->
		<div class="mb-3">
		  <label for="categorySelect" class="form-label">Category</label>
		  <select id="categorySelect" name="category" class="form-select" onchange="updateSubcategories()">
			<option value="">All Categories</option>
			<option value="Men" <%= selectedCategory === 'Men' ? 'selected' : '' %>>Men</option>
			<option value="Women" <%= selectedCategory === 'Women' ? 'selected' : '' %>>Women</option>
		  </select>
		</div>
  
		<!-- Subcategory -->
		<div class="mb-3">
		  <label for="subCategorySelect" class="form-label">Subcategory</label>
		  <select id="subCategorySelect" name="subCategory" class="form-select">
			<option value="">All Subcategories</option>
			<option value="Casual" <%= selectedSubCategory === 'Casual' ? 'selected' : '' %>>Casual</option>
			<option value="Sports" <%= selectedSubCategory === 'Sports' ? 'selected' : '' %>>Sports</option>
			<option value="Formal" <%= selectedSubCategory === 'Formal' ? 'selected' : '' %>>Formal</option>
		  </select>
		</div>
  
		<!-- Price Range -->
		<div class="mb-3">
		  <label for="priceMin" class="form-label">Min Price (₹)</label>
		  <input type="number" id="priceMin" name="priceMin" placeholder="Min ₹" value="<%= priceMin || '' %>" class="form-control" />
		</div>
  
		<div class="mb-3">
		  <label for="priceMax" class="form-label">Max Price (₹)</label>
		  <input type="number" id="priceMax" name="priceMax" placeholder="Max ₹" value="<%= priceMax || '' %>" class="form-control" />
		</div>
  
		<button type="submit" class="btn text-white w-100" style="background-color: #339999;">Apply</button>
	  </div>
  
	  <!-- Right Column: Products -->
	  <div class="col-md-8 col-lg-9">
		<div class="d-flex justify-content-end mt-3">
			<select id="sort" name="sort" class="form-select" style="max-width: 180px;">
			  <option value="">Sort By</option>
			  <option value="low-to-high" <%= sort === 'low-to-high' ? 'selected' : '' %>>Price: Low to High</option>
			  <option value="high-to-low" <%= sort === 'high-to-low' ? 'selected' : '' %>>Price: High to Low</option>
			  <option value="a-z" <%= sort === 'a-z' ? 'selected' : '' %>>Name: A-Z</option>
			  <option value="z-a" <%= sort === 'z-a' ? 'selected' : '' %>>Name: Z-A</option>
			</select>
		  </div>
		  
		<!-- Your products will render here -->

		<div class="colorlib-product">
			<div class="container">
				<!-- <div class="row">
					<div class="col-sm-8 offset-sm-2 text-center colorlib-heading colorlib-heading-sm">
						<h2>View All Products</h2>
					</div>
				</div> -->
		
				<div class="colorlib-product">
					<div class="row row-pb-md">
						<% products.forEach(product => { %>
							<div class="col-lg-3 mb-4 text-center">
								<div class="product-entry border">
									<a href="#" class="prod-img">
										<% if (product.images && product.images.length > 0) { %>
											<a href="/product-detail/<%= product._id %>">
											  
											 
											  
											<img src="/uploads/products/<%= product.images[0] %>" class="img-fluid" alt="<%= product.name %>">
										</a>
										<% } else { %>
											<img src="/images/default.jpg" class="img-fluid" alt="Default image">
										<% } %>
									</a>
									<div class="desc">
										<!-- Product Name -->
								   
										<h6><a href="/product-detail/<%= product._id %>"><%= product.name %></a></h6>
										<!-- Price -->
										<span class="price">₹<%= product.price %></span>
										
										
										
										<!-- Action Buttons (Add to Wishlist) -->


										<div class="text-center mt-2">
											<a href="/wishlist/add/<%= product._id %>" class="btn btn-sm" style="border: 1px solid #339999;">
												<i class="bi bi-heart-fill" style="color: #339999;"></i> 
                                             </a>
										</div>


										
									</div>
								</div>
							</div>
						<% }) %>
					</div>
				</div>
			</div>
		</div>

<!-- end -->




	  </div>
	</div>
  </div>
  

<!-- code -->


          
        
       


<!-- Pagination -->
<div class="pagination mt-4 d-flex justify-content-center">
	<% if (totalPages > 1) { %>
	  <nav aria-label="Page navigation">
		<ul class="pagination">
		  <!-- Previous button -->
		  <% if (currentPage > 1) { %>
			<li class="page-item">
			  <a class="page-link" href="/shop?page=<%= currentPage - 1 %>&query=<%= query %>&category=<%= selectedCategory %>&subCategory=<%= selectedSubCategory %>&priceMin=<%= priceMin %>&priceMax=<%= priceMax %>&sort=<%= sort %>" aria-label="Previous">
				<span aria-hidden="true">&laquo;</span>
			  </a>
			</li>
		  <% } else { %>
			<li class="page-item disabled">
			  <span class="page-link">&laquo;</span>
			</li>
		  <% } %>
  
		  <!-- Page numbers -->
		  <% 
		  <!-- // Calculate start and end page numbers -->
		  let startPage = Math.max(1, currentPage - 2);
		  let endPage = Math.min(totalPages, startPage + 4);
		  
		  <!-- // Adjust if fewer than 5 pages shown -->
		  if (endPage - startPage < 4) {
			startPage = Math.max(1, endPage - 4);
		  }
		  
		  <!-- // Generate page links -->
		  for (let i = startPage; i <= endPage; i++) { 
		  %>
			<li class="page-item <%= i === currentPage ? 'active' : '' %>">
			  <a class="page-link" href="/shop?page=<%= i %>&query=<%= query %>&category=<%= selectedCategory %>&subCategory=<%= selectedSubCategory %>&priceMin=<%= priceMin %>&priceMax=<%= priceMax %>&sort=<%= sort %>">
				<%= i %>
			  </a>
			</li>
		  <% } %>
  
		  <!-- Next button -->
		  <% if (currentPage < totalPages) { %>
			<li class="page-item">
			  <a class="page-link" href="/shop?page=<%= currentPage + 1 %>&query=<%= query %>&category=<%= selectedCategory %>&subCategory=<%= selectedSubCategory %>&priceMin=<%= priceMin %>&priceMax=<%= priceMax %>&sort=<%= sort %>" aria-label="Next">
				<span aria-hidden="true">&raquo;</span>
			  </a>
			</li>
		  <% } else { %>
			<li class="page-item disabled">
			  <span class="page-link">&raquo;</span>
			</li>
		  <% } %>
		</ul>
	  </nav>
	<% } %>
	
	<!-- Showing X of Y products -->
	<div class="text-center mt-2">
	  <p class="text-muted">
		Showing <%= products.length %> of <%= totalProducts %> products
	  </p>
	</div>
  </div>


</form>




