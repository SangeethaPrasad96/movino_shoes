          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Name *</label>
              <input type="text" class="form-control" name="fullName" value="<%= defaultAddress.fullName %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Mobile *</label>
              <input type="tel" class="form-control" name="phone" value="<%= defaultAddress.phone %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Pincode *</label>
              <input type="text" class="form-control" name="pincode" value="<%= defaultAddress.pincode %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">State *</label>
              <input type="text" class="form-control" name="state" value="<%= defaultAddress.state %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">City *</label>
              <input type="text" class="form-control" name="city" value="<%= defaultAddress.city %>" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Address *</label>
              <textarea class="form-control" name="addressLine" required><%= defaultAddress.addressLine %></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save</button>
          </div>
        </div>
      </form>
    </div>
  </div>
<!-- /////////   -->


      <div class="card-header bg-light">
