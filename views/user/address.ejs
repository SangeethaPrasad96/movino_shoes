<!-- 🟢 Modal for defaultAddress -->
<div class="modal fade" id="editAddressModal-<%= defaultAddress._id %>" tabindex="-1" aria-labelledby="editAddressModalLabel-<%= defaultAddress._id %>" aria-hidden="true">
    <div class="modal-dialog">
      <form action="/address/edit/<%= defaultAddress._id %>" method="POST">
