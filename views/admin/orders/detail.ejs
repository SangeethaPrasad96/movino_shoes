<%- include("../../views/partials/admin/header") %>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container mt-5 mb-5">
  <div class="card shadow">
    <div class="card-header bg-primary text-white">
      <h3 class="mb-0">Order Details - <%= order.orderId %></h3>
      <small>Date: <%= order.createdAt.toDateString() %></small><br>
      <small>User: <strong><%= order.user.name %></strong> (<%= order.user.email %>)</small>
    </div>

    <div class="card-body">
      <h5 class="mb-3 text-secondary"> Items</h5>
      <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
          <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Status</th>
            <th>Refund</th>
          </tr>
        </thead>
        <tbody>
          <% order.orderItems.forEach(item => { %>
            <tr>
              <td><%= item.product.name %></td>
              <td><span class="badge bg-secondary"><%= item.quantity %></span></td>
              <td>
                <% if (item.status === 'Pending') { %>
                  <span class="badge bg-warning text-dark">Pending</span>
                <% } else if (item.status === 'Shipped') { %>
                  <span class="badge bg-info text-dark">Shipped</span>
                <% } else if (item.status === 'Out for Delivery') { %>
                  <span class="badge bg-primary">Out for Delivery</span>
                <% } else if (item.status === 'Delivered') { %>
                  <span class="badge bg-success">Delivered</span>
                <% } else if (item.status === 'Cancelled') { %>
                  <span class="badge bg-danger">Cancelled</span>
                <% } else if (item.status === 'Returned') { %>
                  <span class="badge bg-dark">Returned</span>
                <% } else if (item.status === 'Refunded') { %>
                  <span class="badge bg-success">Refunded</span>
                <% } else { %>
                  <span class="badge bg-secondary">Unknown</span>
                <% } %>
              </td>
              <td>
                <% if (item.status === 'Return Request' || item.status === 'Returned') { %>
                  <form id="verifyForm-<%= item._id %>" method="POST" action="/admin/orders/verify-return/<%= order.orderId %>/<%= item._id %>" class="d-inline">
                    <input type="hidden" name="action" id="action-<%= item._id %>" value="">
                    <button type="button" class="btn btn-sm btn-outline-warning" onclick="showPopup('<%= item._id %>')">Verify Refund</button>
                  </form>
                <% } else if (item.status === 'Refunded') { %>
                  <span class="badge bg-success">Refunded</span>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <hr class="my-4">

     
      <% if (order.orderItems[0].status !== 'Cancelled') { %>
        <h5 class="text-secondary">Update Order Status</h5>
        <form method="POST" action="/admin/orders/update-status/<%= order.orderId %>" class="row g-3 align-items-center mt-2">
          <div class="col-md-4">
            <select name="status" class="form-select border-primary" required>
              <option value="Pending" <%= order.orderItems[0].status === 'Pending' ? 'selected' : '' %>>Pending</option>
              <option value="Shipped" <%= order.orderItems[0].status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
              <option value="Out for Delivery" <%= order.orderItems[0].status === 'Out for Delivery' ? 'selected' : '' %>>Out for Delivery</option>
              <option value="Delivered" <%= order.orderItems[0].status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
              <option value="Cancelled" <%= order.orderItems[0].status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
              <option value="Returned" <%= order.orderItems[0].status === 'Returned' ? 'selected' : '' %>>Returned</option>
            </select>
          </div>
          <div class="col-auto">
            <button type="submit" class="btn btn-success">Update</button>
          </div>
        </form>
      <% } else { %>
        <h5 class="text-secondary text-danger">This order was cancelled</h5>
      <% } %>
      



    </div>

    <div class="mt-3 ms-3">
      <a href="/admin/orders" class="btn btn-outline-secondary">
        ← Back to Order List
      </a>
    </div>
    
  </div>
</div>

<script>
  function showPopup(itemId) {
    Swal.fire({
      title: 'Are you sure?',
      text: "Accept return and refund to wallet?",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Accept',
      cancelButtonText: 'Reject',
      reverseButtons: true
    }).then((result) => {
      const form = document.getElementById(`verifyForm-${itemId}`);
      const actionInput = document.getElementById(`action-${itemId}`);

      if (result.isConfirmed) {
        actionInput.value = 'accept';
        form.submit();
      } else if (result.dismiss === Swal.DismissReason.cancel) {
        actionInput.value = 'reject';
        form.submit();
      }
    });
  }
</script>




<%- include("../../views/partials/admin/footer") %>
