<%- include("../../views/partials/admin/header") %>


<div class="d-flex justify-content-center align-items-start" style="min-height: 100vh; padding-top: 80px;">
    <div class="w-100" style="max-width: 800px;">
      <h3 class="text-center mb-4">Manage Variants for "<%= product.name %>"</h3>


  <!-- Existing variants table -->
  <h4>Existing Variants</h4>
  <% if (!product.variants || product.variants.length === 0) { %>
    <p>No variants added yet.</p>
  <% } else { %>
    <table class="table table-bordered">
      <thead>
        <tr>
          <th>Size</th>
          <th>Price (₹)</th>
          <th>Quantity</th>
        </tr>
      </thead>
      <tbody>
        <% product.variants.forEach(variant => { %>
          <tr>
            <td><%= variant.size %></td>
            <td>₹<%= variant.price %></td>
            <td><%= variant.quantity %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <!-- Form to add new variants -->
  <h4>Add New Variant(s)</h4>
  <form action="/admin/products/<%= product._id %>/variants" method="POST" id="variantForm">
    <div id="variantsContainer">
      <div class="variant-row mb-3">
        <input type="text" name="sizes[]" placeholder="Size (e.g. S, M, L)" class="form-control mb-2" required>
        <input type="number" name="prices[]" placeholder="Price (₹)" class="form-control mb-2" required>
        <input type="number" name="quantities[]" placeholder="Quantity" class="form-control mb-2" required>
      </div>
    </div>
    <button type="button" id="addMoreVariants" class="btn btn-secondary mb-3">➕ Add More Size</button>
    <br>
    <button type="submit" class="btn btn-primary">Save Variants</button>
  </form>
</div>
</div>

<script>
  // Add more variant input rows dynamically
  document.getElementById('addMoreVariants').addEventListener('click', () => {
    const container = document.getElementById('variantsContainer');
    const variantRow = document.createElement('div');
    variantRow.className = 'variant-row mb-3';
    variantRow.innerHTML = `
      <input type="text" name="sizes[]" placeholder="Size (e.g. S, M, L)" class="form-control mb-2" required>
      <input type="number" name="prices[]" placeholder="Price (₹)" class="form-control mb-2" required>
      <input type="number" name="quantities[]" placeholder="Quantity" class="form-control mb-2" required>
    `;
    container.appendChild(variantRow);
  });
</script>







<%- include("../../views/partials/admin/footer") %>